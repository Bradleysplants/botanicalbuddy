# Copy to botanicalbuddy/.env (git-ignored). Loaded by python-dotenv in settings.py.
# All values below are placeholders.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# --- PostgreSQL (needs the pgvector extension; `docker compose up -d db` provides one) ---
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=botanical_assistant
DATABASE_USER=botanical
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- AI agent: "openai" (default) or "local" (Ollama) ---
AI_AGENT_TYPE=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_SYSTEM_MESSAGE=You are a helpful botanical assistant.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL_NAME=llama2
OLLAMA_EMBEDDING_MODEL_NAME=all-mpnet-base-v2

# --- Q&A caching ---
SIMILARITY_THRESHOLD=0.75

# --- Only for backend/load_trefel_data.py (Trefle plant importer) ---
TREFLE_API_KEY=your-trefle-token
