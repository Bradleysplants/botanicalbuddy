# Copy to frontend/.env (git-ignored). Read by Nuxt at build/start time.
# All values below are placeholders.

# Origin the app is served from; required by @sidebase/nuxt-auth in production builds.
AUTH_ORIGIN=http://localhost:3000

# Auth0 application settings (see nuxt.config.ts)
AUTH0_DOMAIN=your-tenant.example.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Base URL the browser uses for the backend API (proxied to :8000 by Nitro)
NUXT_ENV_API_BASE_URL=/api
